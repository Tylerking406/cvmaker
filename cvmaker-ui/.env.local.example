# Copy this file to .env.local (it is gitignored).
#
# Where to proxy /api/* requests. The .NET API owns authentication and all data,
# so it must be running for the app to work — there is no longer a mock mode.
#
#   docker compose up --build     → API at http://api:5133 (set for you in compose)
#   dotnet run in CvMaker.Api/    → API at http://localhost:5133 (the default below)
#
# See DEVELOPMENT.md for backend setup and the seeded dev account.
BACKEND_URL=http://localhost:5133
