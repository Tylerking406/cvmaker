# Copy to .env (gitignored). Docker Compose reads it automatically.
#
# The production override (docker-compose.prod.yml) declares every one of these as
# required, so a missing value stops the deploy instead of silently falling back to a
# development default.

# ─── Domain and TLS ───────────────────────────────────────────────────────────
# The subdomain this is served on. Used for the certificate, CORS, the token issuer,
# and the base of password-reset links.
DOMAIN=cv.yourdomain.com

# Let's Encrypt sends expiry warnings here.
ACME_EMAIL=you@yourdomain.com

# ─── Secrets ──────────────────────────────────────────────────────────────────
# HS256 signing key. The value committed in docker-compose.yml is public, so the API
# refuses to start with it in any environment other than Development.
#   openssl rand -base64 48
SUPABASE_JWT_SECRET=

# Postgres password. The base compose file uses cvmaker_local for local dev only.
#   openssl rand -base64 32
POSTGRES_PASSWORD=

# ─── Email (required outside Development) ─────────────────────────────────────
# Without SMTP the API falls back to writing reset links to the log, which would lock
# users out with no visible failure — so it refuses to start instead.
#
# Brevo's free tier is 300 emails/day, permanent, and is plain SMTP.
# Sign up, then Senders & IPs -> SMTP & API to get the credentials below.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=no-reply@yourdomain.com

# ─── Optional ─────────────────────────────────────────────────────────────────
# CIDRs allowed to set X-Forwarded-For. Defaults to the RFC1918 ranges, which is right
# when the API is only reachable from inside the compose network. Narrow it if the API
# is ever exposed more widely — an untrusted client that can set this header gets a
# fresh identity per request and walks through the auth rate limiter.
# TrustedProxyNetworks=172.16.0.0/12
