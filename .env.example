# Copy to .env (gitignored). Docker Compose reads it automatically.

# ─── Required outside Development ────────────────────────────────────────────
# HS256 signing key for the API's JWTs. The compose fallback is committed to this
# repo and therefore public — the API refuses to start with it in any environment
# other than Development.
#   openssl rand -base64 48
SUPABASE_JWT_SECRET=

# ─── Required outside Development ────────────────────────────────────────────
# Without SMTP the API falls back to writing reset links to the log, which would
# silently lock users out of their accounts. It refuses to start in that state
# outside Development.
# Email__Smtp__Host=smtp.example.com
# Email__Smtp__Port=587
# Email__Smtp__Username=
# Email__Smtp__Password=
# Email__Smtp__From=no-reply@yourdomain.com

# Public base URL used to build password reset links.
# App__PublicUrl=https://yourdomain.com
